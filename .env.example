OPENROUTER_API_KEY=sk-or-...E_ME
DEEPSEEK_API_KEY=sk-...            # required if [backends.deepseek] enabled
OMLX_HOST=http://127.0.0.1:8000
# OMLX_API_KEY=                 # optional

# --- OpenRouter Key-Rotation (automatisch im Router) ---
# Der Router prüft bei jedem Request (throttled auf 30 s), ob der Prozess länger
# als OPENROUTER_ROTATE_DAYS läuft ODER der Key älter ist — dann rotiert er selbst
# über das Management-API und aktualisiert OPENROUTER_API_KEY/LAST_ROTATION/HASH.
# Management-Key einmalig per ./scripts/store-key.sh in die macOS-Keychain legen
# (Dashboard → Management API Keys → Create New Key). Dieser Key darf NIEMALS
# hier oder in router.toml stehen.
# OPENROUTER_MGMT_KEY_SERVICE=openrouter-management-key   # Keychain-Service-Name
# OPENROUTER_MGMT_KEY=            # Container/CI-Fallback (ohne macOS-Keychain)
# OPENROUTER_LIMIT=50            # USD-Limit pro Key (ohne Limit wird unlimitiert erzeugt)
# OPENROUTER_LIMIT_RESET=monthly # daily|weekly|monthly — Budget-Reset (best-effort)
# OPENROUTER_ROTATE_DAYS=10      # Intervall: Prozess-Laufzeit / Key-Alter (Default 10)
# --- Alerts (Webhook / Telegram) ---
# Konfiguration in config/router.toml unter [alerts]; hier nur Secrets:
# TELEGRAM_BOT_TOKEN=            # Bot-Token, wenn alerts.telegram_token_env=TELEGRAM_BOT_TOKEN
# Artificial Analysis API key (free tier, 1000 req/day). Account + Key:
# https://artificialanalysis.ai/documentation
# AA_API_KEY=
RUST_LOG=info,router_api=debug,router_core=debug,router_providers=debug
ROUTER_CONFIG=config/router.toml
